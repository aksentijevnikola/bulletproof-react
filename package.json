{
  "name": "bulletproof-react",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "api:gen": "orval --config orval.config.ts",
    "api:check": "node scripts/check-generated-api.ts",
    "ui:add": "shadcn add",
    "build": "vp build && tsc -b",
    "typecheck": "tsc -b --pretty false",
    "lint": "vp lint",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "fsd:check": "cross-env CHOKIDAR_USEPOLLING=1 steiger ./src",
    "check": "pnpm format:check && pnpm fsd:check && pnpm typecheck && pnpm lint && pnpm api:check && pnpm test:ci && pnpm build",
    "preview": "vp preview",
    "test": "vp test",
    "test:ci": "vp test run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "outdated": "vp outdated",
    "outdated:fresh": "vp outdated -- --config.minimum-release-age=0",
    "upgrade:interactive": "vp update -i",
    "upgrade:latest": "vp update --latest && vp install",
    "upgrade:latest:fresh": "vp update --latest -- --config.minimum-release-age=0 && vp install -- --config.minimum-release-age=0",
    "prepare-vite-hooks": "node scripts/prepare-vite-hooks.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.103.2",
    "@tanstack/react-router": "1.170.39",
    "@tanstack/react-table": "9.2.4",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.48.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@playwright/test": "1.63.0",
    "@rolldown/plugin-babel": "0.2.4",
    "@tanstack/router-plugin": "1.168.40",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "10.1.0",
    "happy-dom": "20.14.5",
    "msw": "2.15.0",
    "orval": "8.37.0",
    "shadcn": "4.21.0",
    "steiger": "0.7.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.6.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "ignore"
    }
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
