# --------------------------------------------------
# Application Environment
# --------------------------------------------------
VITE_APP_ENV=development

# --------------------------------------------------
# API Configuration
# --------------------------------------------------
VITE_API_BASE_URL=http://localhost:3001/api
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# --------------------------------------------------
# Feature Flags (Frontend only)
# --------------------------------------------------
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_DEBUG_TOOLS=true
VITE_ENABLE_MOCK_API=true
VITE_ENABLE_PERFORMANCE_MONITORING=false

# --------------------------------------------------
# UI Configuration (Display only)
# --------------------------------------------------
VITE_DEFAULT_THEME=light
VITE_DEFAULT_LOCALE=en
VITE_DATE_FORMAT=dd/MM/yyyy

# --------------------------------------------------
# React Query Cache Configuration
# --------------------------------------------------
VITE_QUERY_STALE_TIME=300000
VITE_QUERY_GC_TIME=600000
VITE_ENABLE_OFFLINE=false

# --------------------------------------------------
# Security Awareness (Frontend only)
# --------------------------------------------------
VITE_SESSION_TIMEOUT=1800000
VITE_CSRF_PROTECTION=true
VITE_CSP_ENABLED=true

# --------------------------------------------------
# Logging & Debug
# --------------------------------------------------
VITE_LOG_LEVEL=debug

# --------------------------------------------------
# Development Configuration
# --------------------------------------------------
VITE_MOCK_API_DELAY=500
